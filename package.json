{
  "name": "job-radar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "serve": "node dist/src/server.js"
  },
  "dependencies": {
    "pg": "8.23.1",
    "cheerio": "1.2.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2"
  }
}
